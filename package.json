{
  "name": "regiq",
  "private": true,
  "version": "1.4.0-cloudflare-beta",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "test:ui": "npm --prefix frontend run test:e2e",
    "test:mobile": "npm --prefix frontend run test:e2e:mobile",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
