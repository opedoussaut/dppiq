# REGIQ self-host / local FastAPI configuration
#
# The public Cloudflare deployment does NOT require this file or an HF token.
# Cloudflare Workers AI is configured through the `AI` binding in wrangler.jsonc.
#
# Copy this file to .env only for local/FastAPI/Docker development.
# NEVER commit a real token or secret.

# Vision provider for the Python backend
REGIQ_VISION_ENABLED=true
REGIQ_VISION_PROVIDER=huggingface
REGIQ_HF_MODEL=auto

# Ollama alternative
REGIQ_VISION_MODEL=qwen3-vl:2b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Multi-agent regulation investigation for the Python backend
REGIQ_AGENTIC_REGULATION_ENABLED=true
REGIQ_REGULATION_MODEL=auto
REGIQ_VERIFIER_MODEL=auto

# Hugging Face Inference Providers - self-host mode only
# Create a fine-grained token with the required inference permission.
HF_TOKEN=

# Optional request-scoped BYO token support for self-host mode.
REGIQ_ALLOW_BYO_HF_TOKEN=true

# Optional model provenance overrides for self-host deployments.
REGIQ_MODEL_LICENSE=
REGIQ_MODEL_SOURCE_URL=

# PUBLIC CLOUDFLARE RUNTIME
# No API/model secret is required here. See:
#   wrangler.jsonc
#   cloudflare/worker.js
# Deploy with: npm run deploy
