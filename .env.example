# REGIQ example configuration
# Copy to .env locally if you use an env loader, or export these variables in your shell.
# NEVER commit a real token or secret.

# Vision
REGIQ_VISION_ENABLED=true
REGIQ_VISION_PROVIDER=huggingface
REGIQ_HF_MODEL=auto
REGIQ_VISION_MODEL=qwen3-vl:2b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Multi-agent regulation investigation
# When enabled, REGIQ asks an investigator LLM to screen the full verified
# regulatory corpus and a verifier LLM to challenge the proposed findings.
# Deterministic mappings remain available as a fallback and benchmark.
REGIQ_AGENTIC_REGULATION_ENABLED=true
REGIQ_REGULATION_MODEL=auto
REGIQ_VERIFIER_MODEL=auto

# Hugging Face Inference Providers
# Create your own fine-grained token with Inference Providers permission.
HF_TOKEN=

# Optional per-request BYO token support.
# When enabled, API clients may pass X-REGIQ-HF-Token on /api/scan/image.
# The same request-scoped token can be used for vision + regulatory agents.
# It is not persisted by REGIQ.
REGIQ_ALLOW_BYO_HF_TOKEN=true

# Optional model provenance overrides for deployments that pin a vision model.
# If REGIQ_HF_MODEL=auto, REGIQ will report the model actually selected at runtime.
REGIQ_MODEL_LICENSE=
REGIQ_MODEL_SOURCE_URL=
