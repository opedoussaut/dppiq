{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "regiq-dev",
  "main": "./cloudflare/fast-worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
